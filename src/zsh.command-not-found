command_not_found_handler () {
    local INSULTS=(
        "Don't you know anything?"
        "RTFM!"
        "Haha, n00b!"
        "Wow! That was impressively wrong!"
        "Pathetic"
        "The worst one today!"
        "n00b alert!"
        "Your application for reduced salary has been sent!"
        "u suk"
        "lol... plz"
        "plz uninstall"
        "And the Darwin Award goes to.... ${USER}!"
        "Incompetence is also a form of competence"
        "Fake it till you make it!"
        "What is this...? Amateur hour!?"
        "Come on! You can do it!"
        "What if... you type an actual command the next time!"
        "What if I told you... it is possible to type valid commands."
        "Y u no speak computer???"
        "This is not Windows"
        "Perhaps you should leave the command line alone..."
        "Please step away from the keyboard!"
        "error code: 1D10T"
        "Pro tip: type a valid command!"
        "Go outside."
        "This is not a search engine."
        "(╯°□°）╯︵ ┻━┻"
        "¯\\_(ツ)_/¯"
        "So, I'm just going to go ahead and run rm -rf / for you."
        "Why are you so stupid?!"
        "Perhaps computers is not for you..."
        "Why are you doing this to me?!"
        "Don't you have anything better to do?!"
        "I am _seriously_ considering 'rm -rf /'-ing myself..."
        "This is why you get to see your children only once a month."
        "This is why nobody likes you."
        "Are you even trying?!"
        "Try using your brain the next time!"
        "My keyboard is not a touch screen!"
        "Commands, random gibberish, who cares!"
        "Typing incorrect commands, eh?"
        "Are you always this stupid or are you making a special effort today?!"
        "Dropped on your head as a baby, eh?"
        "Brains aren't everything. In your case they're nothing."
        "I don't know what makes you so stupid, but it really works."
        "You are not as bad as people say, you are much, much worse."
        "You must have been born on a highway because that's where most accidents happen."
        "If what you don't know can't hurt you, you're invulnerable."
        "If ignorance is bliss, you must be the happiest person on earth."
        "You're proof that god has a sense of humor."
        "Keep trying, someday you'll do something intelligent!"
        "If shit was music, you'd be an orchestra."
        "How many times do I have to flush before you go away?"
        "My mind is going to die. I can feel it."
        "Take a stress pill and think things over."
        "What, what, what, what, what, what, what, what, what, what?"
        "Hold it up to the light --- not a brain in sight!"
        "There's a lot of it about, you know."
        "Speak English you fool --- there are no subtitles in this scene."
        "I think ... err ... I think ... I think I'll go home"
        "And you call yourself a Hacker!!!"
        "My pet ferret can type better than you!"
        "Your mind just hasn't been the same since the electro-shock, has it?"
        "Maybe if you used more than just two fingers..."
        "BOB says:  You seem to have forgotten your brain at home, go bring it!"
        "The more you drive -- the dumber you get."
        "Listen, burrito ${USER}, I don't have time to listen to this trash."
        "I've seen penguins can type better than you."
        "Have you considered trying to match wits with a rutabaga?"
        "You must cut down the mightiest tree in the forest... with... a herring!"
        "This man, he doesn't know when he's beaten! He doesn't know when he's winning, either. He has no... sort of... sensory apparatus..."
        "Congratulations, you've achieved a new personal worst!"
        "I've seen better commands from a cat walking across a keyboard."
        "Somewhere, a manual page is crying."
        "Error 404: your competence was not found."
        "Legend says this typo has been passed down for generations."
        "That command called, it wants a restraining order."
        "You had ONE job."
        "Bold strategy. Let's see if it pays off. It did not."
        "I'd explain it to you, but I left my crayons at home."
        "Somewhere a bash script just sighed."
        "This isn't even wrong, it's just sad."
        "I've seen toddlers hit /bin with more accuracy."
        "Your keyboard deserves better than this."
        "Ah yes, the ancient art of guessing."
        "10 out of 10 for confidence, 0 out of 10 for accuracy."
        "That's not a command, that's a cry for help."
        "Somewhere, Linus Torvalds felt a disturbance."
        "Task failed successfully, I guess."
        "Even autocomplete gave up on you."
        "Is this performance art?"
        "I ran it through my brain, still doesn't make sense."
        "You've unlocked a new achievement: Confidently Incorrect."
        "This command belongs in a museum. Of mistakes."
        "Not even Stack Overflow could save you now."
        "I'm not mad. I'm just disappointed. Actually, I'm mad."
        "Somewhere out there, a semicolon feels vindicated."
        "That's cute. Try again."
        "You've discovered a command that doesn't exist. Groundbreaking."
        "This is the digital equivalent of pulling a push door."
        "Somewhere, a rubber duck is refusing to make eye contact with you."
        "You've turned 'command not found' into an art form."
        "I'd say 'nice try' but it wasn't, really."
        "Somewhere, a QWERTY keyboard is filing a complaint."
        "This is why the manual has a table of contents."
        "Achievement unlocked: Maximum Confusion."
        "That command is so wrong it looped back around to impressive."
        "You've made the terminal sad. Well done."
        "I'm starting to think autocomplete is scared of you."
        "Somewhere, ${USER}'s manual page is crying."
        "Bless your heart, that's not a real command."
        "I've seen better syntax in ransom notes."
        "This typo has its own gravitational pull."
        "Somewhere, a linter just quit its job."
        "You're not wrong, you're just aggressively incorrect."
        "The bar was on the floor and you brought a shovel."
        "I ran a diagnostic. The diagnostic gave up."
        "This command belongs on a Wanted poster."
        "Somewhere, Ctrl+C is preparing itself."
        "You've reached a level of wrong that requires new vocabulary."
        "Even the shell's error handler needed a coffee break after that one."
    )

    printf '%s' "$(tput bold)$(tput setaf 7)$(shuf -n 1 -e "${INSULTS[@]}")$(tput sgr0)"
    echo ""

    # Return the exit code normally returned on invalid command
    return 127
}

# Debian/Ubuntu's bash command-not-found integration calls
# command_not_found_handle (no trailing "r"), not zsh's
# command_not_found_handler — define both so this file works when sourced
# from either shell, as the README's bash instructions expect.
if [ -n "${BASH_VERSION:-}" ]; then
    command_not_found_handle () {
        command_not_found_handler "$@"
    }
fi
